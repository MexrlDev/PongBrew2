#!/usr/bin/env python3
"""create-gp4 shim matching LibOrbisPkg's Gp4Project XML schema exactly.
   chunk_info lives INSIDE <volume>. Files use targ_path/orig_path.
"""
import os, argparse
import xml.etree.ElementTree as ET


def indent(elem, level=0):
    i = "\n" + level * "  "
    if len(elem):
        if not elem.text or not elem.text.strip():
            elem.text = i + "  "
        if not elem.tail or not elem.tail.strip():
            elem.tail = i
        for child in elem:
            indent(child, level + 1)
        if not child.tail or not child.tail.strip():
            child.tail = i
    else:
        if level and (not elem.tail or not elem.tail.strip()):
            elem.tail = i


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("-out", "--out", default="homebrew.gp4")
    ap.add_argument("--content-id", required=True)
    ap.add_argument("--files", required=True)
    args = ap.parse_args()

    files = []
    for path in args.files.split():
        p = path.replace("\\", "/")
        if p.startswith("./"):
            p = p[2:]
        files.append(p)

    root = ET.Element("psproject", {"fmt": "gp4", "version": "1000"})

    # --- volume (chunk_info nested INSIDE) ---
    vol = ET.SubElement(root, "volume")
    ET.SubElement(vol, "volume_type").text = "pkg_ps4_app"
    ET.SubElement(vol, "volume_id").text = "PS4VOLUME"
    ET.SubElement(vol, "volume_ts").text = "2024-01-01 00:00:00"
    ET.SubElement(vol, "package", {
        "content_id": args.content_id,
        "passcode": "00000000000000000000000000000000",
        "storage_type": "bd50",
        "app_type": "full",
    })
    ci = ET.SubElement(vol, "chunk_info", {
        "chunk_count": "1", "scenario_count": "1",
    })
    chunks = ET.SubElement(ci, "chunks")
    ET.SubElement(chunks, "chunk", {"id": "0", "layer_no": "0", "label": "Chunk #0"})
    scen = ET.SubElement(ci, "scenarios", {"default_id": "0"})
    ET.SubElement(scen, "scenario", {
        "id": "0", "type": "sp", "initial_chunk_count": "1", "label": "Scenario #0",
    }).text = "0"

    # --- files (targ_path / orig_path) ---
    files_el = ET.SubElement(root, "files", {"img_no": "0"})
    for p in files:
        ET.SubElement(files_el, "file", {
            "targ_path": p,
            "orig_path": p,
        })

    # --- rootdir (targ_name only, nested by directory depth) ---
    rootdir_el = ET.SubElement(root, "rootdir")
    dir_tree = {}
    for p in files:
        parts = p.split("/")
        for j in range(1, len(parts)):
            path_key = "/".join(parts[:j])
            parent_key = "/".join(parts[:j-1]) if j > 1 else None
            if path_key not in dir_tree:
                dir_tree[path_key] = (parent_key, parts[j-1])

    # Build sorted by depth so parents come first
    for key in sorted(dir_tree, key=lambda k: k.count("/")):
        parent_key, name = dir_tree[key]
        parent_el = rootdir_el
        if parent_key and parent_key in dir_tree:
            parent_el = dir_tree[parent_key].get("_el", rootdir_el)
        el = ET.SubElement(parent_el, "dir", {"targ_name": name})
        dir_tree[key] = {"_el": el}

    indent(root)
    ET.ElementTree(root).write(args.out, encoding="utf-8", xml_declaration=True)
    print("[create-gp4-shim] wrote %s with %d files, %d dirs" %
          (args.out, len(files), len(dir_tree)))


if __name__ == "__main__":
    main()